generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Users ─────────────────────────────
model User {
  id              String   @id
  firebaseUid     String?  @unique
  phone           String?  @unique
  email           String?  @unique
  displayName     String?
  photoUrl        String?
  userType        String   // member | gym_operator | trainer | admin | gym_staff
  accountStatus   String   @default("active") // active | suspended
  approvalStatus  String   @default("approved") // pending_approval | approved | rejected
  passwordHash    String?  // demo only — replace with bcrypt in production
  approvalNote    String?
  onboardingCompleted Boolean @default(false)
  portalUser      Boolean  @default(false)   // true = admin-created portal user (cannot access mobile app)
  aclPermissions  String[] @default([])       // e.g. ['gyms','owners','trainers','members','payments','approvals']
  memberProfile   Json?    // fitness goals, level, height, weight, dob, gender, workout times
  gymId           String?  // primary gym for operators
  gymIds          String[] @default([]) // multiple gyms for operators
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions    Subscription[]
  checkins         Checkin[]
  wallet           CreditsWallet?
  paymentRequests  PaymentRequest[]
  trainerProfile   TrainerProfile?
  trainerBookings  TrainerBooking[] @relation("BookingMember")

  @@index([userType])
  @@index([accountStatus])
  @@index([phone])
}

// ───────────────────────────── Gyms ─────────────────────────────
model Gym {
  id             String   @id
  name           String
  tier           String   // standard | midtier | premium | luxury_executive | online
  location       String
  venueType      String   @default("physical") // physical | online
  accessMode     String   @default("paid_visit") // paid_visit | free_online
  operatingHours Json?
  perVisitRate   Int      @default(0)
  ratePerDay     Int      @default(0)
  ratePerWeek    Int      @default(0)
  ratePerMonth   Int      @default(0)
  commissionRate Int      @default(12)
  status         String   @default("active") // active | inactive | suspended
  images         String[] @default([])
  thumbnails     String[] @default([]) // small WebP previews, parallel to `images` (same index = same photo)
  coordinates    Json?    // { lat: number, lng: number }
  amenities      String[] @default([]) // e.g. ['WiFi', 'Shower', 'Sauna', 'Parking']
  equipment      String[] @default([]) // e.g. ['Treadmill', 'Dumbbells', 'Bench Press']
  paymentBank    String?  // Bank/FSP name
  paymentNumber  String?  // Payment account number
  paymentNotes   String?  // Notes for payment
  tinNumber      String?  // Tax Identification Number
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  checkins         Checkin[]
  invoices         Invoice[]
  gymPayouts       GymPayout[]
  trainerProfiles  TrainerProfileGym[]
  trainerBookings  TrainerBooking[]

  @@index([status])
  @@index([tier])
}

// ───────────────────────────── Subscriptions ─────────────────────
model Subscription {
  id             String   @id
  memberId       String
  type           String   // platform_pass | direct_sub | roaming_topup
  tier           String?  // basic | pro | premium | executive
  status         String   // active | expired | suspended | payment_pending | payment_rejected
  startedAt      DateTime
  cycleStartedAt DateTime
  renewsAt       DateTime
  expiresAt      DateTime
  homeGymId      String?
  paymentRef     String?
  createdAt      DateTime @default(now())

  member User @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@index([renewsAt])
}

// ───────────────────────────── Payment Requests ──────────────────
model PaymentRequest {
  id             String    @id
  memberId       String
  subscriptionId String
  tier           String
  amountTzs      Int
  status         String    // pending | approved | rejected | cancelled
  provider       String    // admin_manual | selcom | mpesa
  reference      String?
  note           String?
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  decidedBy      String?

  member User @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([status])
}

// ───────────────────────────── Check-ins ─────────────────────────
model Checkin {
  id                 String   @id
  memberId           String
  gymId              String
  timestamp          DateTime
  method             String   // gym_scanned | self_checkin
  subscriptionType   String
  passTier           String?
  visitNumberInCycle Int?
  gymTier            String
  creditsDeductedTzs Int      @default(0)
  visitConsumed      Boolean

  member User @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gym    Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([memberId, gymId, timestamp])
  @@index([gymId, timestamp])
  @@index([memberId, timestamp])
}

// ───────────────────────────── Invoices ──────────────────────────
model Invoice {
  id               String    @id
  gymId            String
  gymName          String
  ownerId          String?
  ownerName        String?
  amount           Int
  status           String    @default("unpaid") // unpaid | paid
  note             String?
  periodStart      String?
  periodEnd        String?
  receiptUrl       String?
  paymentReference String?
  createdAt        DateTime  @default(now())
  createdBy        String
  paidAt           DateTime?

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, periodStart, periodEnd])
  @@index([status])
}

// ───────────────────────────── Gym Payouts ───────────────────────
model GymPayout {
  id          String    @id
  gymId       String
  invoiceId   String?
  amount      Int
  status      String    // paid | pending
  periodStart String?
  periodEnd   String?
  paidAt      DateTime?
  reference   String?
  createdAt   DateTime  @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, periodStart, periodEnd])
}

// ───────────────────────────── Trainer Profiles ──────────────────
model TrainerProfile {
  id              String   @id
  userId          String?  @unique
  email           String?
  phone           String?
  displayName     String
  photoUrl        String?
  gender          String?  // male | female | other
  specialties     String[] @default([])
  bio             String?
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  hourlyRateTzs   Int      @default(0)
  experienceYears Int      @default(0)
  status          String   @default("active") // active | suspended
  approvalStatus  String   @default("approved")
  pendingGymIds   String[] @default([]) // gyms the trainer has applied to, awaiting owner approval
  availability    Json?    // [{ date, slots }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  gyms     TrainerProfileGym[]
  bookings TrainerBooking[]

  @@index([status])
}

model TrainerProfileGym {
  trainerId String
  gymId     String

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  gym     Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([trainerId, gymId])
}

// ───────────────────────────── Trainer Bookings ──────────────────
model TrainerBooking {
  id         String   @id
  memberId   String
  trainerId  String
  gymId      String
  date       String
  slot       String
  amountTzs  Int
  status     String   @default("confirmed") // confirmed | completed | cancelled
  createdAt  DateTime @default(now())

  member  User           @relation("BookingMember", fields: [memberId], references: [id], onDelete: Cascade)
  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  gym     Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([trainerId])
}

// ───────────────────────────── Credits Wallet ────────────────────
model CreditsWallet {
  id          String    @id
  userId      String    @unique
  balanceTzs  Int       @default(0)
  lastTopUpAt DateTime?
  expiresAt   DateTime?

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditsTransaction[]
}

model CreditsTransaction {
  id        String   @id
  walletId  String
  amountTzs Int
  type      String   // topup | deduction | refund
  reference String?
  createdAt DateTime @default(now())

  wallet CreditsWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

// ───────────────────────────── Platform Settings ─────────────────
model PlatformSettings {
  id                 String   @id @default("platform")
  subscriptionTiers  Json     // SubscriptionTierConfig[]
  payoutBands        Json     // PayoutBandConfig[]
  paymentPeriodDays  Int      @default(14)
  payoutModel        String   @default("commission") // commission | discounted_rate
  currency           String   @default("TZS")
  updatedAt          DateTime @updatedAt
}

// ───────────────────────────── Audit Log ─────────────────────────
model AuditLog {
  id     String   @id
  at     DateTime @default(now())
  actor  String?
  action String
  target String
  before Json?
  after  Json?

  @@index([actor])
  @@index([action])
  @@index([at])
}

// ───────────────────────────── Webhook Idempotency ───────────────
model WebhookSeen {
  id String   @id
  at DateTime @default(now())

  @@index([at])
}

// ───────────────────────────── OTP (ephemeral) ───────────────────
model Otp {
  phone     String   @id
  code      String?
  userType  String
  expiresAt DateTime

  @@index([expiresAt])
}
