{
  "name": "fitflex-functions",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/migrate.mjs && node scripts/seed.mjs",
    "knex:migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "knex:migrate:ci": "FITFLEX_USE_CI_DB=1 knex --knexfile knexfile.cjs migrate:latest",
    "knex:migrate:make": "knex --knexfile knexfile.cjs migrate:make",
    "knex:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "db:setup": "node scripts/create-db.mjs && npm run knex:migrate",
    "db:setup:ci": "FITFLEX_USE_CI_DB=1 node scripts/create-db.mjs && npm run knex:migrate:ci",
    "test": "FITFLEX_USE_CI_DB=1 KYC_ENFORCEMENT=off DB_POOL_IDLE_TIMEOUT_MS=200 node --test --test-concurrency=1 --test-reporter=tap --test-reporter-destination=stdout --test-reporter=./scripts/test-completeness-reporter.mjs --test-reporter-destination=stdout 'specs/**/*.specs.mjs'",
    "dev:fs": "bfast fs serve --port 3000",
    "start:fs": "bfast fs serve --port 3000 --static"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "axios": "^1.19.0",
    "bfast-function": "^3.2.4",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.8.0",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "pg": "^8.20.0",
    "sharp": "^0.35.3"
  },
  "private": true
}
