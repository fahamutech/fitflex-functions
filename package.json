{
  "name": "fitflex-functions",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate && prisma migrate deploy && node scripts/seed.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:ci": "DATABASE_URL=${DATABASE_URL_CI:-$DATABASE_URL} prisma migrate deploy",
    "db:setup": "node scripts/create-db.mjs && prisma migrate deploy && prisma generate",
    "db:setup:ci": "DATABASE_URL=${DATABASE_URL_CI:-$DATABASE_URL} node scripts/create-db.mjs && DATABASE_URL=${DATABASE_URL_CI:-$DATABASE_URL} prisma migrate deploy",
    "test": "DATABASE_URL=${DATABASE_URL_CI:-$DATABASE_URL} node --test 'specs/**/*.specs.mjs'",
    "dev:fs": "bfast fs serve --port 3000",
    "start:fs": "bfast fs serve --port 3000 --static"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bfast-function": "^3.2.4",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.8.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "prisma": "^7.8.0"
  },
  "private": true
}
