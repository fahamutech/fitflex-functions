# FitFlex Functions — Environment Configuration
# ─────────────────────────────────────────────────────────
# CRITICAL for production:
#   NODE_ENV=production
#   JWT_SECRET=<64+ char cryptographically random string>
#   DATABASE_URL=<production postgres connection string>
#   FIREBASE_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS
# ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# REQUIRED in production: Used to sign session JWTs. Must be 64+ chars.
# In production: failing to set this will crash the server on startup.
JWT_SECRET=replace-with-a-long-random-secret

# Postgres/Knex database. Run `npm run knex:migrate` before first start.
DATABASE_URL=postgresql://joshua:joshua@localhost/fitflex
DATABASE_URL_CI=postgresql://joshua:joshua@localhost/fitflex_ci

# Firebase Admin SDK. Use exactly one of these in production.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"fitflex-af-pilot",...}'
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=<base64-encoded service account JSON> (auto-detected)
FIREBASE_PROJECT_ID=fitflex-af-pilot

# Comma-separated Google account emails that should resolve to FitFlex admin
# during Firebase Auth session exchange.
FITFLEX_ADMIN_EMAILS=mama27j@gmail.com,nassabuba@gmail.com

# Selcom payment gateway (wire for production mobile money integration)
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_VENDOR=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_WEBHOOK_SECRET=

# Zebra shared storage service (image/file uploads — gyms, trainers, receipts).
ZEBRA_BASE_URL=https://cms.gsmgroup.africa

# ─────────────────────────────────────────────────────────
# WhatsApp for member communications (campaigns and automations)
# ─────────────────────────────────────────────────────────
# Which provider sends WhatsApp messages. Unset (the default) = not
# configured: nothing is sent and WhatsApp messages are skipped. "fake" is
# for local development only and is refused when NODE_ENV=production.
# A real provider's credentials go in its own variables here once its
# adapter is added — never in code or the database.
# WHATSAPP_PROVIDER=
# meta = Meta's WhatsApp Cloud API. It needs these three; until all are set
# WhatsApp stays off and the admin WhatsApp page lists which are missing.
#   WHATSAPP_META_ACCESS_TOKEN=          (system-user token, never a personal one)
#   WHATSAPP_META_PHONE_NUMBER_ID=       (the sending number's id in Meta)
#   WHATSAPP_META_BUSINESS_ACCOUNT_ID=   (the WhatsApp Business Account id)
#   WHATSAPP_META_API_VERSION=v23.0      (optional)
# Shared secret the provider's webhook URL must carry:
#   https://<api>/webhooks/whatsapp/status?token=<secret>
# Unset = the webhook refuses every call.
WHATSAPP_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────
# Africa's Talking WhatsApp Integration (direct service messages: sign-in codes, bookings, orders)
# ─────────────────────────────────────────────────────────
# Sign up: https://africastalking.com
# Get API Key from: Dashboard → Settings → API Keys
# Optional: leave unset to disable WhatsApp (sends return 503 whatsapp_not_configured).
AFRICAS_TALKING_API_KEY=
# App username from the AT dashboard; "sandbox" for the sandbox environment.
AFRICAS_TALKING_USERNAME=sandbox
# For sandbox testing: https://api.sandbox.africastalking.com
# For production: https://api.africastalking.com
AFRICAS_TALKING_API_URL=https://api.sandbox.africastalking.com
# Shared secret for system-to-system routes (POST /whatsapp/send-otp carries
# it as x-fitflex-internal-token). Unset = those routes are closed.
# FITFLEX_INTERNAL_TOKEN=

# SMS for reminders and campaigns (see SMS.md). Nothing is sent until a
# provider is named. "beem" uses BEEM_API_KEY / BEEM_SECRET_KEY (the same
# pair verification codes use); "fake" keeps messages in memory and is
# ignored in production. BEEM_SENDER_ID is the sender name members see:
# "INFO" (Beem's shared name, the default) until FitFlex's own is approved.
# SMS_PROVIDER=
# BEEM_SENDER_ID=INFO

# Identity V2 · I6a: verification codes FitFlex sends to prove a phone or email.
# Nothing is sent until a provider is named.
#   SMS: "beem" (Beem Africa) needs BEEM_API_KEY, BEEM_SECRET_KEY and the
#        sender name registered with Beem in VERIFICATION_SMS_SENDER_ID
#        (or BEEM_SENDER_ID, below).
#   Email: "mailgun" needs MAILGUN_API_KEY and MAILGUN_DOMAIN
#        (MAILGUN_API_URL=https://api.eu.mailgun.net for the EU region).
#   "fake" keeps messages in memory and is ignored in production.
# VERIFICATION_SMS_PROVIDER=
# VERIFICATION_SMS_SENDER_ID=
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# VERIFICATION_EMAIL_PROVIDER=
# VERIFICATION_EMAIL_FROM=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# Limits (defaults shown): 6 digits, 10 minutes, 5 wrong tries, 60 s between
# sends, 5 codes per identifier per hour, 10 requests per person per day.
# VERIFY_CODE_LENGTH=6
# VERIFY_CODE_EXPIRY_MINUTES=10
# VERIFY_CODE_MAX_ATTEMPTS=5
# VERIFY_CODE_RESEND_SECONDS=60
# VERIFY_CODE_PER_IDENTIFIER_PER_HOUR=5
# VERIFY_CODE_PER_PERSON_PER_DAY=10

# Identity V2 · I7a: sign-in with a number or email + PIN (flag V2_PIN_LOGIN).
# PIN_PEPPER is the key each PIN is mixed with before it is hashed. Required in
# production, long and random, and it must never change: changing it makes
# every stored PIN stop working. FIREBASE_WEB_API_KEY (the project's public web
# key) lets existing users' Firebase PINs be checked once so they can be adopted.
# PIN_PEPPER=
# FIREBASE_WEB_API_KEY=
# Registration (I7b) limits, defaults shown: code requests per network address
# per hour, and a daily cap on registration codes (the guard on the SMS bill).
# REGISTER_STARTS_PER_ADDRESS_PER_HOUR=10
# REGISTER_CODES_PER_DAY=1000
# Invitations (start PIN): the link put in the message a staff member or
# trainer receives. A placeholder until the app is in the stores.
# APP_DOWNLOAD_LINK=https://fitflex-af-app.web.app

# Account recovery for someone who lost every verified number and email (needs
# IDENTITY_V2 + V2_RECOVERY). Confirmed 5 Oct 2026: a member waits 24 hours before
# a FitFlex admin can decide; a cancelled or refused request blocks a new one for 7 days.
# PUBLIC_API_URL is the backend's public address, used in the cancel link sent to the owner.
# RECOVERY_WAIT_HOURS_MEMBER=24
# RECOVERY_BLOCK_DAYS=7
# RECOVERY_STARTS_PER_ADDRESS_PER_DAY=3
# PUBLIC_API_URL=https://fitflex-faas.bfast.smartstock.co.tz

# Record Firebase sign-in evidence while Identity V2 linking (V2_LINKING) is off:
# each Firebase session writes its uid, verified email and Firebase phone as
# verified LoginIdentifier rows on the signer's own person (never on a row owned
# by another Firebase account). Friend invitations match only those rows, so
# until this is on (or scripts/identity-reconcile.mjs --firebase --apply has run)
# members verified only by Firebase are not matched by email. Off unless set.
# IDENTITY_RECORD_FIREBASE_EVIDENCE=on

# B2B operations alerts: who is emailed about high-severity exceptions (comma separated).
# Unset = nobody is emailed. OPS_PORTAL_LINK is an optional link put in the email.
OPS_ALERT_EMAILS=
OPS_PORTAL_LINK=

# Malipo by Tunzaa (pay by mobile money). Dormant until TUNZAA_PAYMENTS=on and both keys are set.
# MALIPO_ENV is 'sandbox' unless it is exactly 'live' (a key starting SB_ is always sandbox).
# Against the sandbox, Pay now is offered only with TUNZAA_SANDBOX_SETTLES=on, because an approved
# sandbox payment still activates a real plan: set it on a test server only.
# The callback URL to register in Malipo's merchant settings is <PUBLIC_API_URL>/webhooks/tunzaa.
MALIPO_API_KEY=
MALIPO_API_SECRET=
MALIPO_ENV=sandbox
TUNZAA_PAYMENTS=
TUNZAA_SANDBOX_SETTLES=
# B6a: trainer sessions (members) and trainer gym passes (trainers) by mobile money. Needs TUNZAA_PAYMENTS too.
TUNZAA_TRAINER_PRODUCTS=

# Vendor business tools (docs/plans/vendor-business-tools-plan.md). All off unless set; a tool is on
# only when VENDOR_TOOLS and its own flag are both on. S1: VENDOR_STOCK_LEDGER. S2: VENDOR_PORTAL
# (GET /vendor/me opens the web portal), VENDOR_ORDER_BUYER_CONTACT (buyer phone on vendor orders,
# while the vendor's part is open and 7 EAT days after delivery). S3: VENDOR_WALKIN_SALES (POS / walk-in
# sales, no commission, not in settlement). S4: VENDOR_CUSTOMERS (customers, pay later, customer payments,
# aging, and the 09:00 EAT overdue digest job).
VENDOR_TOOLS=
VENDOR_STOCK_LEDGER=
VENDOR_PORTAL=
VENDOR_ORDER_BUYER_CONTACT=
VENDOR_WALKIN_SALES=
VENDOR_CUSTOMERS=
# S5: VENDOR_DOCUMENTS (share links, public page /d/:token + PDF, order invoices, buyer invoice json/html/pdf).
# Share links also need PUBLIC_API_URL to be set (above): without it they are refused with 503
# public_url_not_configured — there is NO fallback host for documents (Q-1). Pick the public domain once:
# links already sent keep the address that was set when they were made.
# VENDOR_VAT (tax profile + KYC review, product VAT codes, admin tax rates, VAT on vendor sales/invoices).
# VENDOR_DOCUMENTS_TIN_WITHOUT_VAT (Q-10, owner pending; default off): also print the KYC TIN of vendors
# who are not VAT-registered, once their TIN certificate is accepted.
VENDOR_DOCUMENTS=
VENDOR_VAT=
VENDOR_DOCUMENTS_TIN_WITHOUT_VAT=
# Public document page /d/:token: which X-Forwarded-For entry is the client, counted from the right (each of
# our proxies appends the address it saw). 1 (default) = the address our nearest proxy saw; 0 = no proxy,
# use the socket address. Entries further left are client-supplied and never trusted. PUBLIC_API_URL must be https.
PUBLIC_DOCS_TRUSTED_PROXY_HOPS=

# Phase B · B1a: trainer session outcomes (docs/trainer-session-outcomes-api.md). Off unless set:
# POST /trainer/bookings/:id/no-show answers 404 feature_disabled, admins cannot set no_show and
# bookings carry no `actions`. The start-time check on /trainer/bookings/:id/complete is always on.
# TRAINER_SESSION_OUTCOMES=on
